#!/usr/bin/env bash
# Fast checks before every commit: formatting, lints and type checks, docs, tests. The full set is scripts/check.sh.
# Enable once per clone: git config core.hooksPath .githooks   (or: just hooks). Skip in an emergency: git commit --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1
bash scripts/check-sensitive.sh staged
echo "pre-commit: fmt, clippy, docs, tests"
cargo fmt --all --check || { echo "pre-commit: run 'cargo fmt --all' (or 'just fmt')" >&2; exit 1; }
cargo clippy --workspace --all-targets --locked -q -- -D warnings
RUSTDOCFLAGS="-D warnings" cargo doc --workspace --no-deps --locked -q
cargo test --workspace --locked -q
